DRY_RUN=true
EMERGENCY_STOP=false
# Never put credentials in this file or commit real .env files.
RAKUTEN_APPLICATION_ID=
RAKUTEN_AFFILIATE_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
OPENAI_API_KEY=
# Server-only database connection. Never put these in Pages or client JavaScript.
STORAGE_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT alternative:
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random 32-byte key encoded in base64; keep an offline copy for recovery.
BACKUP_ENCRYPTION_KEY=
